{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloppyjoe.local/ohm/contracts/genesis-event.schema.json",
  "title": "OHM Genesis Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "observed_at",
    "source",
    "kind",
    "payload",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "ohm.genesis.event.v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "observation",
        "reflection",
        "decision",
        "action",
        "outcome",
        "correction",
        "cleanup"
      ]
    },
    "payload": { "type": "object" },
    "salience": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "relation", "weight"],
        "properties": {
          "target_id": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": -1.0, "maximum": 1.0 }
        }
      }
    },
    "affect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "joy": { "$ref": "#/$defs/affectDimension" },
        "serenity": { "$ref": "#/$defs/affectDimension" },
        "love": { "$ref": "#/$defs/affectDimension" },
        "curiosity": { "$ref": "#/$defs/affectDimension" },
        "awe": { "$ref": "#/$defs/affectDimension" },
        "vitality": { "$ref": "#/$defs/affectDimension" },
        "resolve": { "$ref": "#/$defs/affectDimension" },
        "stillness": { "$ref": "#/$defs/affectDimension" },
        "grace": { "$ref": "#/$defs/affectDimension" },
        "presence": { "$ref": "#/$defs/affectDimension" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256"],
      "properties": {
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parent_event_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "producer": { "type": "string" },
        "producer_version": { "type": "string" }
      }
    }
  },
  "$defs": {
    "affectDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "sensitivity", "corr_ema"],
      "properties": {
        "activation": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "sensitivity": { "type": "number", "minimum": 0.0, "maximum": 4.0 },
        "corr_ema": { "type": "number", "minimum": -1.0, "maximum": 1.0 }
      }
    }
  }
}
